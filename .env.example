# Optional. Without any key, nudge copy and the merchant brief fall back to
# deterministic templates and everything still runs. No metric depends on
# a model call: the model only writes copy for a decision policy.py already
# made.

# Which provider to call. "gemini" (default) or "anthropic". Anything else,
# including a typo, also falls back to templates.
LLM_PROVIDER=gemini

# Gemini free tier: aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic (paid). Only used when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6
